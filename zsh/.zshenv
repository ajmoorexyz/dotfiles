# ~/.zshenv - sourced by EVERY zsh (login, interactive, scripts).
# Keep this tiny and side-effect free.

export DOTFILES="$HOME/code/dotfiles"
export ZDOTDIR_CONFIG="$HOME/.config/zsh"

# Where projects live (used by `co` and friends)
export PROJECTS_DIR="$HOME/code"

# Editor
export VISUAL="code -n"
export EDITOR="code -n"

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

export LANG="en_US.UTF-8"
