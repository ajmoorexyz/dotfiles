# Ghostty - https://ghostty.org/docs/config/reference
# Managed in ~/code/dotfiles. Reload in place with cmd+shift+,

# ------------------------------------------------------------- appearance ---
# "Dracula", not "Dracula+". They are different palettes despite the name:
# Dracula+ is the VS Code variant and changes blue (#bd93f9 -> #82aaff),
# magenta (#ff79c6 -> #c792ea), yellow (#f1fa8c -> #ffcb6b), bright black
# (#6272a4 -> #545454) and the background (#282a36 -> #212121). That made
# every directory listing and prompt segment render a different colour here
# than in iTerm, which uses stock Dracula.
theme = Dracula

# No `background` override. It used to be #303343 - lifted off Dracula's
# stock #282a36 so herdr's catppuccin chrome (#181825) read as a distinct
# plane. That cost an exact colour match with iTerm, which matters more.
# Restore the override if herdr's panels stop reading as separate.

font-family = MesloLGS Nerd Font Mono
font-size = 14
font-thicken = true

cursor-style = block
cursor-style-blink = false

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-save-state = always

macos-titlebar-style = tabs
macos-option-as-alt = true

# ---------------------------------------------------------------- behavior ---
scrollback-limit = 100000000
copy-on-select = clipboard
confirm-close-surface = true
mouse-hide-while-typing = true

# Shell integration drives cursor shape, sudo password prompts, and window
# titles. It also powers jump-to-prompt (cmd+up / cmd+down).
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --------------------------------------------------------------- clicking ---
# cmd+click follows links. Ghostty 1.3.1 cannot be configured to match bare
# file paths (the `link` option is documented but not yet settable), so
# clickable paths come from tools that emit OSC 8 hyperlinks instead:
# `eza --hyperlink` for listings and `rg --hyperlink-format` for search hits.
link-url = true
link-previews = true

# ---------------------------------------------------------------- keybinds ---
# Claude Code multi-line input. Without this, shift+enter submits.
keybind = shift+enter=text:\n

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down

# Jump between prompts (needs shell-integration, above)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

keybind = cmd+shift+comma=reload_config
