[alias]
	lp = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
	co = checkout
	st = status
[color]
	ui = true
	status = always
[pull]
	rebase = true
[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[gpg]
	program = gpg
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[merge]
	tool = smerge
[diff]
	tool = default-difftool
[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE
[mergetool "smerge"]
	cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
	trustExitCode = true
[branch]
	autosetuprebase = always
[init]
	defaultBranch = main

# Identity, credential helpers and safe.directory are per-machine, not
# per-repo: this same file lands on a work laptop and a personal one. They
# live in ~/.gitconfig.local, which is never tracked and never stowed.
#
# This include MUST stay last. Git applies values in file order and the last
# one wins, so an include placed higher up would be silently overridden by
# anything below it.
[include]
	path = ~/.gitconfig.local
